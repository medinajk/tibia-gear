<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5EF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comparação de equipamentos"
            android:textColor="#281900"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#775000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textSecondName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#775000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textCompareSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="#49443A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textCompareValues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="8dp"
            android:textColor="#201D17"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonBackToItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="Voltar aos equipamentos" />
    </LinearLayout>
</ScrollView>
